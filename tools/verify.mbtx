----
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
}
----

async fn verify_report_files() -> Unit {
  @async.with_task_group(group => {
    let dir = @fs.tmpdir(prefix="zhenread-report")
    let input = "\{dir}/source.srt"
    let report = "\{dir}/report.html"
    group.add_defer(() => {
      @async.protect_from_cancel(() => {
        if @fs.exists(report) {
          @fs.remove(report)
        }
        if @fs.exists(input) {
          @fs.remove(input)
        }
        @fs.rmdir(dir)
      })
    })
    let original = "1\n00:00:01,000 --> 00:00:03,000\n你好\n"
    @fs.write_file(input, original)
    let args = ["run", "cmd/main", "--", "check", input, "--output", "html"]
    let rejected = @shell.Cmd("moon", args + ["--report", input]).output()
    assert_eq(rejected.exit_code(), 2)
    assert_eq(@fs.read_file(input).text(), original)
    let written = @shell.Cmd("moon", args + ["--report", report]).output()
    assert_eq(written.exit_code(), 0)
    let content = @fs.read_file(report).text()
    assert_true(content.contains("你好"))
    assert_true(content.contains("id=\"line-1\""))
    let repeated = @shell.Cmd("moon", args + ["--report", report]).output()
    assert_eq(repeated.exit_code(), 2)
    assert_eq(@fs.read_file(report).text(), content)
  })
}

async fn main {
  let checks = [
    ["check", "--deny-warn"],
    ["test", "--deny-warn"],
    ["build", "--deny-warn"],
    ["fmt", "--check"],
  ]
  for args in checks {
    @shell.Cmd("moon", args).run()
  }
  let cases : Array[(Array[String], Int)] = [
    (["--help"], 0),
    (["check", "examples/clean.srt"], 0),
    (["check", "examples/review.vtt"], 0),
    (["check", "examples/review.vtt", "--strict"], 1),
    (["check", "examples/recovery.vtt"], 1),
    (["check", "examples/clean.srt", "--output", "json"], 0),
    (["check", "examples/clean.srt", "--profile", "invalid"], 2),
    (["check", "examples/clean.srt", "--profile"], 2),
    (["check", "missing.srt"], 2),
    (["compare", "examples/revision-before.vtt", "examples/revision-before.vtt"], 0),
    (["compare", "examples/revision-before.vtt", "examples/revision-after.vtt", "--output", "json"], 1),
    (["compare", "examples/revision-before.vtt", "examples/recovery.vtt"], 2),
    (["compare", "examples/revision-before.vtt", "examples/revision-after.vtt", "--tolerance-ms", "-1"], 2),
  ]
  for (args, expected) in cases {
    let result = @shell.Cmd("moon", ["run", "cmd/main", "--"] + args).output()
    assert_eq(result.exit_code(), expected)
  }
  verify_report_files()
  let paired = @shell.Cmd("moon", [
    "run", "cmd/main", "--", "compare", "examples/revision-before.vtt",
    "examples/revision-after.vtt", "--output", "html",
  ]).output()
  assert_eq(paired.exit_code(), 1)
  assert_true(paired.stdout().contains("文字与时间变更"))
  assert_true(paired.stdout().contains("这里展示原始术语"))
  assert_true(paired.stdout().contains("这里展示修订术语"))
  println("CLI cases: \{cases.length()} passed.")
  println("Report file checks: creation and overwrite protection passed.")
  println("Revision HTML: both versions and change reasons verified.")
}
